{
  "opencollection": "1.0.0",
  "info": {
    "name": "International Business Machines IBM Cloud Object Storage Analyze Environments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Environments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "International Business Machines List environments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://s3.us-south.cloud-object-storage.appdomain.cloud/v2/assistants/:assistant_id/environments",
            "params": [
              {
                "name": "assistant_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List the environments associated with an assistant."
        }
      ]
    }
  ],
  "bundled": true
}