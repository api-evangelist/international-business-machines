{
  "opencollection": "1.0.0",
  "info": {
    "name": "International Business Machines IBM Cloud Object Storage Analyze Recognition API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Recognition",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "International Business Machines Recognize audio",
            "type": "http"
          },
          "http": {
            "method": "POST",
